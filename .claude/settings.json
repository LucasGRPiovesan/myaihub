{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "TEMP": "L:\\.npm-tmp",
    "TMP": "L:\\.npm-tmp",
    "npm_config_cache": "L:\\.npm-cache"
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run lint:fix)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm run build)",
      "Bash(npm test)",
      "Bash(npm run test:*)",
      "Bash(npm run db:generate)",
      "Bash(npm run clean)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "PowerShell(npm run typecheck)",
      "PowerShell(npm run lint)",
      "PowerShell(npm run format)",
      "PowerShell(npm run build)",
      "PowerShell(npm test)"
    ],
    "deny": [
      "Bash(docker system prune *)",
      "Bash(docker volume rm *)",
      "Bash(docker volume prune *)",
      "PowerShell(docker system prune *)",
      "PowerShell(docker volume rm *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-api-write.cjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*prisma migrate dev*)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-prisma-migrate.cjs\""
          }
        ]
      }
    ]
  }
}
