# =============================================================================
# MyAIHub — variáveis de ambiente
# Copie para `.env` e preencha. NUNCA comite `.env`.
# =============================================================================

NODE_ENV=development
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Portas / URLs
# -----------------------------------------------------------------------------
API_PORT=3333
WEB_PORT=5173
API_URL=http://localhost:3333
WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# -----------------------------------------------------------------------------
# Banco (MySQL 8) — os MYSQL_* alimentam o docker-compose
# -----------------------------------------------------------------------------
# Onde o /var/lib/mysql do container é montado no HOST. Fica no SSD de
# propósito (é o dado de maior I/O do ambiente); banco de dev é descartável —
# apagar esta pasta com o compose parado apaga o banco inteiro.
MYSQL_DATA_DIR=C:/DockerRuntime/myaihub/mysql

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=myaihub
MYSQL_USER=myaihub
MYSQL_PASSWORD=myaihub
MYSQL_ROOT_PASSWORD=root

DATABASE_URL="mysql://myaihub:myaihub@localhost:3306/myaihub"

# Banco dos testes de integracao (eles truncam tabelas — nunca aponte para o de dev)
TEST_DATABASE_URL="mysql://myaihub:myaihub@localhost:3306/myaihub_test"
SHADOW_DATABASE_URL="mysql://myaihub:myaihub@localhost:3306/myaihub_shadow"

# -----------------------------------------------------------------------------
# Auth
# Gere segredos com:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=troque-este-valor-em-desenvolvimento
JWT_REFRESH_SECRET=troque-este-outro-valor-em-desenvolvimento
ACCESS_TOKEN_TTL=12h
REFRESH_TOKEN_TTL=30d
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# -----------------------------------------------------------------------------
# Seed (apenas desenvolvimento — nunca use estes defaults em produção)
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@myaihub.local
SEED_ADMIN_PASSWORD=Admin@123456
SEED_TEST_EMAIL=teste@myaihub.local
SEED_TEST_PASSWORD=Teste@123456

# -----------------------------------------------------------------------------
# AI Providers
# Basta configurar os que você usa. Providers sem chave são registrados como
# indisponíveis e falham com PROVIDER_NOT_CONFIGURED — o boot nunca quebra.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
# Chave PAGA, usada só quando a cota gratuita do dia acaba (mesmo modelo).
# Precisa vir de um projeto com faturamento PRÓPRIO: os limites do Gemini são
# por projeto, não por chave — duas chaves do mesmo projeto dividem a mesma
# cota e não haveria fallback nenhum. Vazia: roda só com a gratuita.
GEMINI_API_KEY_PAYED=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Provider/model por role. Formato: <provider>:<model>
# providers: fake | gemini | openai | anthropic
MODEL_ROLE_HUB_REASONING=gemini:gemini-3.5-flash-lite
MODEL_ROLE_HUB_FAST=gemini:gemini-3.5-flash-lite
MODEL_ROLE_AGENT_RUNTIME=gemini:gemini-3.5-flash-lite
MODEL_ROLE_VALIDATION_FAST=gemini:gemini-3.5-flash-lite
MODEL_ROLE_ANALYSIS_VISION=gemini:gemini-3.5-flash-lite

# -----------------------------------------------------------------------------
# Storage (MediaAsset)
# -----------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# Onde os bytes de MediaAsset ficam. Relativo à raiz do repositório.
MEDIA_DIR=.media
