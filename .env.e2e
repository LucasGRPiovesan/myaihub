# Ambiente do E2E (Playwright, Fase 11).
#
# Carregado DEPOIS do .env, então o que está aqui vence. O que muda em relação
# ao desenvolvimento é só o necessário para o teste ser reproduzível:
#
#   - banco PRÓPRIO, para o E2E semear sem apagar o trabalho em andamento;
#   - provider FAKE, porque o que se testa aqui é a aplicação e não o modelo
#     (invariante 8) — um E2E que depende do Gemini falha por indisponibilidade
#     alheia e vira ruído que ninguém investiga;
#   - credenciais conhecidas, para o teste conseguir entrar.
#
# Este arquivo é versionado de propósito: não há segredo nele, e sem ele o
# comando de E2E não roda numa máquina nova.

DATABASE_URL="mysql://myaihub:myaihub@localhost:3306/myaihub_e2e"
TEST_DATABASE_URL="mysql://myaihub:myaihub@localhost:3306/myaihub_e2e"

NODE_ENV=development
# PORTA PRÓPRIA, e isto não é detalhe: com o `reuseExistingServer` do
# Playwright, uma API de desenvolvimento no ar na 3333 seria adotada como se
# fosse a do E2E — e os testes rodariam contra o banco de DESENVOLVIMENTO,
# onde o usuário do E2E não existe. Foi o que aconteceu aqui: a suíte falhou
# no login, e a causa estava a duas camadas de distância do sintoma.
API_PORT=3334
# O proxy do `vite preview` lê daqui (a config do Vite aceita API_URL do
# ambiente). Sem isto o build servido bateria na 3333.
API_URL=http://localhost:3334
LOG_LEVEL=warn

# Sem chave: o registry marca os providers pagos como indisponíveis e o
# roteamento cai no fake. O boot NUNCA pode quebrar por falta de chave.
GEMINI_API_KEY=

SEED_ADMIN_EMAIL=e2e@myaihub.local
SEED_ADMIN_PASSWORD=E2ePlaywright@123

# Roteamento explícito para o FAKE. Sem isto, o roteamento herdado do .env
# apontaria para o Gemini e o E2E passaria a depender de um serviço externo.
MODEL_ROLE_HUB_REASONING=fake:fake-1
MODEL_ROLE_HUB_FAST=fake:fake-1
MODEL_ROLE_AGENT_RUNTIME=fake:fake-1
MODEL_ROLE_VALIDATION_FAST=fake:fake-1
MODEL_ROLE_ANALYSIS_VISION=fake:fake-1

SEED_TEST_EMAIL=e2e-user@myaihub.local
SEED_TEST_PASSWORD=E2ePlaywright@123

# A ORDEM dos arquivos importa: `dotenv -e .env.e2e -e .env` dá precedência ao
# PRIMEIRO. Invertida, o E2E rodaria contra o banco de desenvolvimento — e a
# primeira execução aqui fez exatamente isso antes de a ordem ser corrigida.
